{
  "name": "푸른사진첩",
  "short_name": "푸른사진첩",
  "description": "푸른노무법인 사진 보관 — 현장·회의·명함 사진을 한 곳에",
  "start_url": "./pu-photos.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101010",
  "theme_color": "#101010",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "_share_target_주석": "카톡·갤러리에서 「공유」 목록에 푸른사진첩이 뜨게 한다. 안드로이드 전용이고 폰에 설치돼 있어야 뜬다(애플은 막아 두었다). 사진은 POST 로 오므로 pu-photos-sw.js 가 받아 IndexedDB 에 잠깐 두고, 화면이 그것을 읽어 확인 화면을 띄운다.",
  "share_target": {
    "action": "./pu-photos.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "photos", "accept": ["image/*", "application/pdf"] }
      ]
    }
  }
}
