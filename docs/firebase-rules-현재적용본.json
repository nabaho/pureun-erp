{
  "rules": {
    "uid_roles": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      "$uid": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (auth.uid == $uid || root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true)",
        "fin": {
          ".validate": "root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true || newData.val() === false || (data.exists() && newData.val() === data.val())"
        },
        "isAdmin": {
          ".validate": "root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true || newData.val() === false || (data.exists() && newData.val() === data.val())"
        },
        "isSubAdmin": {
          ".validate": "root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true || newData.val() === false || (data.exists() && newData.val() === data.val())"
        }
      }
    },
    "sid_roles": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true"
    },
    "data": {
      "finance_income": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "finance_expense": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "finance_invoice": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "payroll_monthly": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "payroll_irregular": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "funds": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "mgr_rates": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "pay_items": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "dc_contributions": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "retirement_settlements": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "recurring_expenses": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "expense_budget": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "finance_bank_fee": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      "user_dir": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true || root.child('uid_roles').child(auth.uid).child('isSubAdmin').val() == true"
      },
      "$other": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
      },
      "user_accounts": {
        ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true",
        ".write": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
      },
      ".read": "root.child('uid_roles').child(auth.uid).child('fin').val() == true"
    },
    "payroll_os": {
      ".read": "auth != null && (root.child('uid_roles').child(auth.uid).child('fin').val() == true || root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true)",
      ".write": "auth != null && (root.child('uid_roles').child(auth.uid).child('fin').val() == true || root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true)"
    },
    "fund_erp": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "work_erp": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "ieum_public": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "scal_staff": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "scal_types": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "scal_cos": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "scal_scheds": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "scal_env": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "scal_fieldState": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "scal_conflictMatrix": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "scal_roundlog": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "scal_erpTypeMap": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "companies": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".indexOn": [
        "folder",
        "updatedAt"
      ]
    },
    "pucards": {
      ".read": "auth != null && auth.token.email != null",
      ".write": "auth != null && auth.token.email != null"
    },
    "improve_requests": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".indexOn": [
        "authorSid",
        "done"
      ]
    },
    "presence": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "activeWriter": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "appBuild": {
      ".read": true,
      ".write": "root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true"
    },
    "serverBackups": {
      ".read": "root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "serverBackupsIndex": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "serverBackupsRecentIndex": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "kcareer": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "esign": {
      "cases": {
        "$caseId": {
          "meta": {
            ".read": "auth != null",
            ".write": "auth != null && auth.token.email != null"
          },
          "secret": {
            ".read": "auth != null && auth.token.email != null",
            ".write": "auth != null && auth.token.email != null"
          },
          "arrears": {
            ".read": "auth != null && auth.token.email != null",
            ".write": "auth != null && auth.token.email != null"
          },
          "submissions": {
            ".read": "auth != null && auth.token.email != null",
            "$subId": {
              ".write": "(auth != null && !data.exists() && newData.child('t').val() === root.child('esign/cases/' + $caseId + '/meta/linkToken').val() && root.child('esign/cases/' + $caseId + '/meta/status').val() === 'active') || (auth != null && auth.token.email != null)",
              ".validate": "newData.hasChildren(['enc','encKey','iv','t','submittedAt','reviewState']) || (auth != null && auth.token.email != null)",
              "enc": {
                ".validate": "newData.isString() && newData.val().length < 400000"
              },
              "encKey": {
                ".validate": "newData.isString() && newData.val().length < 1000"
              },
              "iv": {
                ".validate": "newData.isString() && newData.val().length < 100"
              },
              "reviewState": {
                ".validate": "newData.isString() && newData.val().matches(/^(pending|confirmed|hold)$/)"
              }
            }
          }
        }
      }
    },
    "rules_mgmt": {
      "wip": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$site": {
            ".validate": "newData.hasChildren(['site','asof'])"
          }
        }
      },
      "done": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        "$site": {
          "$rev": {
            ".write": "auth != null && ( !data.exists() || data.child('ownerUid').val() === auth.uid || root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true ) && ( !newData.exists() || newData.child('ownerUid').val() === auth.uid )",
            ".validate": "newData.hasChildren(['site','asof','ownerUid'])",
            "ownerUid": {
              ".validate": "newData.val() === auth.uid"
            },
            "status": {
              ".validate": "newData.val() === '완료'"
            }
          }
        }
      },
      "orig": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        "$id": {
          ".write": "auth != null && ( !data.exists() || !data.child('ownerUid').exists() || data.child('ownerUid').val() === auth.uid || root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true )"
        }
      },
      "archive": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        "$id": {
          ".write": "auth != null && ( !data.exists() || !data.child('ownerUid').exists() || data.child('ownerUid').val() === auth.uid || root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true )"
        }
      },
      "worksession": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "decisions": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
      },
      "matchfix": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
      }
    },
    "chwieop": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    }
  }
}
