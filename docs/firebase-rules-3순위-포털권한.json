            }
          },
          "blobs": {
            "$year": {
              "$id": {
                ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('puphotos').child('u').child($uid).child('items').child($year).child($id).child('shareWith').child(auth.uid).exists()"
              }
            }
          },
          "thumbs": {
            "$year": {
              "$id": {
                ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('puphotos').child('u').child($uid).child('items').child($year).child($id).child('shareWith').child(auth.uid).exists()"
              }
            }
          }
        }
      },
      "customKinds": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
      },
      "retention": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true || data.child('uid').val() === auth.uid)"
      },
      "sharedTo": {
        "$uid": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (auth.uid === $uid || root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true)",
          "$pid": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((newData.exists() && newData.child('owner').val() === auth.uid) || (!newData.exists() && (data.child('owner').val() === auth.uid || auth.uid === $uid)))",
            ".validate": "!newData.exists() || newData.hasChildren(['owner','year','at'])"
          }
        }
      }
    },
    "pucards_private": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
