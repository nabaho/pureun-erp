// 규정관리 보안규칙 — 이 두 블록만 기존 규칙의 "rules" 안에 끼워 넣으십시오.
// 합쳐 놓은 전체 파일이 필요하면 firebase-rules-전체(붙여넣기용).json 을 쓰십시오.
// 담당자 대조는 계정 uid(ownerUid) 기준 — 푸른 기존 규칙과 같은 방식입니다.
{
  "rules": {
    "rules_mgmt": {
      "wip": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$site": {
            ".validate": "newData.hasChildren(['site','asof'])"
          }
        }
      },
      "done": {
        ".read": "auth != null",
        "$site": {
          "$rev": {
            ".write": "auth != null && ( !data.exists() || data.child('ownerUid').val() === auth.uid || root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true ) && ( !newData.exists() || newData.child('ownerUid').val() === auth.uid )",
            ".validate": "newData.hasChildren(['site','asof','ownerUid'])",
            "ownerUid": {
              ".validate": "newData.val() === auth.uid"
            },
            "status": {
              ".validate": "newData.val() === '완료'"
            }
          }
        }
      },
      "orig": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && ( !data.exists() || !data.child('ownerUid').exists() || data.child('ownerUid').val() === auth.uid || root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true )"
        }
      },
      "archive": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && ( !data.exists() || !data.child('ownerUid').exists() || data.child('ownerUid').val() === auth.uid || root.child('uid_roles').child(auth.uid).child('isAdmin').val() == true )"
        }
      },
      "worksession": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "decisions": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "matchfix": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "chwieop": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
